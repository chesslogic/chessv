{
    "version": "0.2.0",
    "configurations": [
        {
            // Debug all tests in the solution.
            //
            // Workflow:
            //   1. Press F5 with this configuration selected.
            //   2. The test host will print a "Process Id: NNNN" line and pause,
            //      waiting for a debugger to attach (because VSTEST_HOST_DEBUG=1).
            //   3. Use the "attach to process" picker (or rerun with the
            //      Microsoft .NET debugger Attach config) and select that PID.
            //   4. Breakpoints in test code will then hit normally.
            "name": "Debug: All Tests",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}\\ChessV.sln",
                "--no-build"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "env": {
                "VSTEST_HOST_DEBUG": "1"
            }
        },
        {
            // Debug only tests whose FullyQualifiedName contains the current
            // file's base name (e.g. open CrashReportFormatTests.cs, hit F5).
            // Same pause-then-attach workflow as "Debug: All Tests" above.
            "name": "Debug: Current Test File",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}\\ChessV.sln",
                "--no-build",
                "--filter",
                "FullyQualifiedName~${fileBasenameNoExtension}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "env": {
                "VSTEST_HOST_DEBUG": "1"
            }
        }
    ]
}
